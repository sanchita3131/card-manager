# Card Manager — Streamlit Secrets Template
# Copy this to secrets.toml and fill in your values (gitignored).
# For Streamlit Cloud: set these in the dashboard Secrets section.

# --- LLM API Key (OpenRouter) ---
LLM_API_KEY = "sk-or-v1-..."

# --- Google OAuth (drive.file scope — no verification needed) ---
GOOGLE_CLIENT_ID = "134073219304-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "GOCSPX-xxxxxxxxxxxxxxxxxxxx"

# --- OAuth Redirect URI ---
# Local: http://127.0.0.1:8501
# Streamlit Cloud: https://card-manager.streamlit.app
OAUTH_REDIRECT_URI = "https://card-manager.streamlit.app"
