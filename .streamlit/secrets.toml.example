# Card Manager — Streamlit Secrets Template
# Copy this to secrets.toml and fill in your values (gitignored).
# For Streamlit Cloud: set these in the dashboard Secrets section.

# --- LLM API Key (OpenRouter) ---
LLM_API_KEY = "sk-or-v1-..."

# --- Google OAuth Client Config ---
# Paste the entire contents of your oauth_client_secret.json as a single line
# GOOGLE_OAUTH_CLIENT_CONFIG = '{"web":{"client_id":"...","project_id":"...",...}}'

# --- OAuth Redirect URI ---
# Local development (leave as-is for local):
# OAUTH_REDIRECT_URI = "http://127.0.0.1:8501"
# Streamlit Cloud (after deployment):
# OAUTH_REDIRECT_URI = "https://card-manager.streamlit.app"

# --- Google Sheet ID (optional override) ---
# GOOGLE_SHEET_ID = "your-sheet-id"
